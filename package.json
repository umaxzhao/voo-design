{
  "name": "voo-design",
  "productName": "VOO Design",
  "version": "1.0.0-beta.2",
  "license": "MIT",
  "description": "Professional Vector, Motion & 3D Design Editor",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "copy:ort": "node scripts/copy-ort-wasm.mjs",
    "copy:canvaskit": "node scripts/copy-canvaskit-wasm.mjs",
    "predev": "npm run copy:ort && npm run copy:canvaskit",
    "dev": "vite",
    "prebuild": "npm run copy:ort && npm run copy:canvaskit && npm run notices",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "npm run copy:ort && npm run copy:canvaskit && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run copy:ort && npm run copy:canvaskit && npm run notices && vite build --mode electron && node scripts/build-connector-resource.mjs && node scripts/signing-env.mjs --dir",
    "pretest": "npm run copy:canvaskit && node scripts/ensure-dist.mjs",
    "test": "vitest run",
    "bench:design": "node scripts/design-bench/run.mjs",
    "bench:canvas": "CANVAS_PERF_WRITE=1 vitest run tests/unit/canvas_perf_benchmark.test.js",
    "build:extension": "node scripts/build-extension.mjs",
    "test:watch": "vitest",
    "lint:design": "node scripts/check-design.mjs",
    "check:modules": "node scripts/editor-checks.mjs --check",
    "test:module": "node scripts/editor-checks.mjs --run",
    "bridge": "node scripts/cli-bridge.mjs",
    "signal": "node scripts/signaling-server.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "test:e2e": "node tests/e2e/agent_tools.e2e.mjs",
    "test:e2e:qa": "node tests/e2e/qa_flows.e2e.mjs",
    "bench:agent": "node scripts/agent-bench/run.mjs --dry-run",
    "test:e2e:codex": "node tests/e2e/codex_agent.e2e.mjs",
    "test:e2e:claude": "node tests/e2e/claude_agent.e2e.mjs",
    "dist": "npm run copy:ort && npm run copy:canvaskit && npm run notices && vite build --mode electron && node scripts/build-connector-resource.mjs && node scripts/signing-env.mjs --linux AppImage --publish never && npm run verify:package",
    "dist:dir": "npm run copy:ort && npm run copy:canvaskit && npm run notices && vite build --mode electron && node scripts/build-connector-resource.mjs && node scripts/signing-env.mjs --dir",
    "dist:all": "npm run copy:ort && npm run copy:canvaskit && npm run notices && vite build --mode electron && node scripts/build-connector-resource.mjs && node scripts/signing-env.mjs -mwl --publish never",
    "test:e2e:fps": "node tests/e2e/canvas_fps.e2e.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "bench:wasm-engine": "node scripts/bench-wasm-engine.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "analyze:editor": "node scripts/analyze-editor-bundle.mjs",
    "release:build": "node scripts/build-desktop-release.mjs",
    "release:mac-signed": "node scripts/build-signed-mac.mjs",
    "release:smoke": "node scripts/smoke-desktop-release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@voo/canvas-core": "file:vendor/voo-canvas-core",
    "ag-psd": "^31.0.2",
    "autoprefixer": "^10.4.20",
    "canvaskit-wasm": "^0.41.1",
    "concurrently": "^9.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "fs-extra": "^10.1.0",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.47.0",
    "onnxruntime-web": "^1.27.0",
    "playwright": "^1.64.1",
    "postcss": "^8.4.47",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "tailwindcss": "^3.4.14",
    "uzip": "^0.20201231.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wait-on": "^8.0.1",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "run.voo.design",
    "productName": "VOO Design",
    "copyright": "Copyright © VOO Design contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "EULA.md",
      "src/shared/**/*.js",
      "src/content/**/*.js",
      "!**/*.{map,ts,tsx}",
      "!**/{test,tests,__tests__,docs,example,examples,.v8-cache}/**/*",
      "!**/*.md",
      "EULA.md",
      "dist/EULA.md",
      "!dist/fonts/*.ttf",
      "!**/{benchmark,benchmarks,coverage,.nyc_output,.cache}/**/*",
      "!**/node_modules/js-yaml/dist/*.{js,map}",
      "!**/node_modules/js-yaml/bin/**/*",
      "!**/node_modules/semver/bin/**/*",
      "plugins/voo/**/*",
      "scripts/build-agent-plugin.mjs",
      "scripts/mcp-server.mjs",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/connector",
        "to": "connector"
      }
    ],
    "asar": true,
    "artifactName": "VOO-Design-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "electronLanguages": [
        "en",
        "zh_CN"
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "VOO-Design-${version}-${os}-${arch}-setup.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "synopsis": "Professional vector, motion & design editor",
      "description": "VOO Design — local Figma-class UI editor with Affinity-style image tools and a Pencil-class design agent.",
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "voo-design",
      "syncDesktopName": true
    },
    "afterSign": "scripts/notarize.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "umaxzhao",
        "repo": "voo-design"
      }
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "compression": "maximum",
    "appImage": {
      "compression": "xz"
    },
    "portable": {
      "artifactName": "VOO-Design-${version}-${os}-${arch}-portable.${ext}"
    }
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "author": {
    "name": "umaxzhao",
    "url": "https://github.com/umaxzhao/voo-design"
  },
  "desktopName": "voo-design",
  "rendererDependencies": [
    "@voo/canvas-core",
    "ag-psd",
    "canvaskit-wasm",
    "fzstd",
    "lucide-react",
    "onnxruntime-web",
    "prop-types",
    "react",
    "react-dom",
    "uzip",
    "zustand"
  ]
}
