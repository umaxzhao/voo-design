{
  "name": "voo-design",
  "productName": "VOO Design",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Professional Vector, Motion & 3D Design Editor",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "copy:ort": "node scripts/copy-ort-wasm.mjs",
    "copy:canvaskit": "node scripts/copy-canvaskit-wasm.mjs",
    "predev": "npm run copy:ort && npm run copy:canvaskit",
    "dev": "vite",
    "prebuild": "npm run copy:ort && npm run copy:canvaskit",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "npm run copy:ort && npm run copy:canvaskit && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run copy:ort && npm run copy:canvaskit && vite build && electron-builder --dir",
    "pretest": "npm run copy:canvaskit && node scripts/ensure-dist.mjs",
    "test": "vitest run",
    "bench:canvas": "CANVAS_PERF_WRITE=1 vitest run tests/unit/canvas_perf_benchmark.test.js",
    "build:extension": "node scripts/build-extension.mjs",
    "test:watch": "vitest",
    "lint:design": "node scripts/check-design.mjs",
    "bridge": "node scripts/cli-bridge.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "test:e2e": "node tests/e2e/agent_tools.e2e.mjs",
    "bench:agent": "node scripts/agent-bench/run.mjs --dry-run",
    "test:e2e:codex": "node tests/e2e/codex_agent.e2e.mjs",
    "test:e2e:claude": "node tests/e2e/claude_agent.e2e.mjs",
    "dist": "npm run copy:ort && npm run copy:canvaskit && vite build && electron-builder --linux AppImage",
    "dist:dir": "npm run copy:ort && npm run copy:canvaskit && vite build && electron-builder --dir",
    "dist:all": "npm run copy:ort && npm run copy:canvaskit && vite build && electron-builder -mwl",
    "test:e2e:fps": "node tests/e2e/canvas_fps.e2e.mjs"
  },
  "dependencies": {
    "@voo/canvas-core": "file:vendor/voo-canvas-core",
    "ag-psd": "^31.0.2",
    "canvaskit-wasm": "^0.41.1",
    "fs-extra": "^10.1.0",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.47.0",
    "onnxruntime-web": "^1.27.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uzip": "^0.20201231.0",
    "ws": "^8.22.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "playwright": "^1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "run.voo.design",
    "productName": "VOO Design",
    "copyright": "Copyright \u00a9 VOO Design contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "synopsis": "Professional vector, motion & design editor",
      "description": "VOO Design \u2014 local Figma-class UI editor with Affinity-style image tools and a Pencil-class design agent.",
      "target": [
        "AppImage",
        "deb"
      ],
      "desktopName": "voo-design",
      "executableName": "voo-design"
    }
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "author": {
    "name": "umaxzhao",
    "url": "https://github.com/umaxzhao/voo-design"
  }
}
