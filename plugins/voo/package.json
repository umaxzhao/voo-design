{
  "name": "voo",
  "version": "1.0.0",
  "private": true,
  "description": "The single DeepSeek Harness plugin for VOO: canvas MCP tools, the model bridge, and the VOO editor panel in the right sidebar.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voo",
    "mcp",
    "editor"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/model-bridge.js": "./lib/model-bridge.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "deepseek.cordis.yml",
    "locale/*.json",
    "icon.png",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
