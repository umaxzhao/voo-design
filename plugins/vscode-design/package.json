{
  "name": "voo-design-vscode",
  "displayName": "VOO",
  "description": "Embedded VOO editor for VS Code and Cursor",
  "version": "1.0.0",
  "publisher": "voo-design",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Design",
    "Visualization",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:voo.openDesignMode"
  ],
  "contributes": {
    "commands": [
      {
        "command": "voo.openDesignMode",
        "title": "Open Design Mode",
        "category": "VOO"
      }
    ],
    "configuration": {
      "title": "VOO",
      "properties": {
        "voo.editorUrl": {
          "type": "string",
          "default": "http://localhost:5173/?embed=1",
          "description": "URL of the running VOO editor instance."
        }
      }
    }
  }
}
